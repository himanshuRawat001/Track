<!-- Global Toast Feedback -->
<div id="track-toast" role="status" aria-live="polite" class="fixed bottom-5 right-5 z-50 hidden max-w-sm rounded-lg border border-blue-500/30 bg-[#0F1A30] px-4 py-3 text-sm text-white shadow-lg">
  <div class="flex items-center justify-between gap-4">
    <span id="track-toast-message">Updated successfully.</span>
    <button type="button" id="track-toast-close" class="text-xs text-slate-400 hover:text-white">Dismiss</button>
  </div>
</div>

<!-- Accessible Confirmation Dialog -->
<div id="track-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4">
  <div class="w-full max-w-md rounded-xl surface-elevated p-6">
    <h3 id="confirm-title" class="font-display text-2xl font-bold text-white">Confirm Action</h3>
    <p id="confirm-message" class="mt-2 text-sm text-slate-300 leading-relaxed"></p>
    <div class="mt-6 flex items-center justify-end gap-3">
      <button type="button" id="confirm-cancel" class="rounded-lg border border-slate-400/20 px-4 py-2 text-xs font-medium text-slate-200 hover:bg-slate-800/60 min-h-[40px]">Cancel</button>
      <button type="button" id="confirm-accept" class="rounded-lg bg-red-600 px-4 py-2 text-xs font-semibold text-white hover:bg-red-500 min-h-[40px]">Confirm</button>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
</body>
</html>
