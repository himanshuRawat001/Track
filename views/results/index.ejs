<%- include('../partials/head') %>
<%- include('../partials/public-header') %>

<main class="mx-auto max-w-[1360px] px-6 py-10 lg:py-12">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-slate-400/15">
    <div>
      <p class="text-xs font-medium text-blue-400">Verified Scoreboards</p>
      <h1 class="font-display text-4xl lg:text-5xl font-bold text-white mt-1">Match Results</h1>
      <p class="text-sm text-slate-300 mt-2 max-w-2xl">
        Official final scores, top performer honors, and coaching box-score notes across completed collegiate competitions.
      </p>
    </div>
    <a href="/matches" class="rounded-lg border border-slate-400/20 px-4 py-2.5 text-xs font-medium text-slate-200 hover:bg-slate-800/60 transition-colors whitespace-nowrap self-start md:self-auto">
      Upcoming Fixtures →
    </a>
  </div>

  <!-- Filters -->
  <div class="mt-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-3">
      <div role="tablist" aria-label="Outcome filter" class="flex items-center gap-1 p-1 rounded-lg bg-[#0B1324] border border-slate-400/15">
        <button type="button" data-result-outcome="all" class="px-3.5 py-2 text-xs font-medium rounded-md bg-blue-600 text-white transition-colors whitespace-nowrap">All Results</button>
        <button type="button" data-result-outcome="win" class="px-3.5 py-2 text-xs font-medium rounded-md text-slate-300 hover:text-white transition-colors whitespace-nowrap">Wins</button>
        <button type="button" data-result-outcome="loss" class="px-3.5 py-2 text-xs font-medium rounded-md text-slate-300 hover:text-white transition-colors whitespace-nowrap">Losses</button>
      </div>

      <label for="result-sport-filter" class="sr-only">Filter results by sport</label>
      <select id="result-sport-filter" class="rounded-lg border border-slate-400/20 bg-[#0B1324] px-3.5 py-2 text-xs font-medium text-white focus:border-blue-500 min-h-[40px]">
        <option value="all">All Sports</option>
        <% sports.forEach((sp) => { %>
          <option value="<%= sp.id %>"><%= sp.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="w-full lg:w-72">
      <label for="result-search" class="sr-only">Search match results</label>
      <input id="result-search" type="search" placeholder="Search opponent, MVP, or venue..." class="w-full rounded-lg border border-slate-400/20 bg-[#0B1324] px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-blue-500" />
    </div>
  </div>

  <!-- Results Scoreboards -->
  <div id="results-list" class="mt-8 space-y-4">
    <% results.forEach((match) => {
      const won = match.homeScore >= match.awayScore;
      const margin = Math.abs(match.homeScore - match.awayScore);
    %>
      <article
        class="surface-card rounded-xl p-6"
        data-result-row
        data-sport-id="<%= match.sportId %>"
        data-outcome="<%= won ? 'win' : 'loss' %>"
        data-search="<%= (match.title + ' ' + match.sportName + ' ' + (match.mvp || '') + ' ' + match.venue).toLowerCase() %>"
      >
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="space-y-1.5 min-w-0">
            <p class="text-xs text-slate-400">
              <span class="text-blue-400 font-medium"><%= match.sportName %></span>
              <span aria-hidden="true"> · </span>
              <span><%= match.round %></span>
              <span aria-hidden="true"> · </span>
              <span class="tabular-nums"><%= match.date %></span>
              <span aria-hidden="true"> · </span>
              <span><%= match.venue %></span>
            </p>
            <h2 class="font-display text-2xl lg:text-3xl font-bold text-white">
              <%= match.homeTeam %> <span class="text-slate-400 font-normal">vs.</span> <%= match.awayTeam %>
            </h2>
            <p class="text-sm text-slate-300 pt-1"><%= match.notes %></p>
          </div>

          <div class="flex items-center justify-between lg:justify-end gap-8 shrink-0 pt-4 lg:pt-0 border-t lg:border-t-0 border-slate-400/15">
            <div>
              <p class="text-xs text-slate-400">Top Performer</p>
              <p class="text-sm font-medium text-white mt-0.5"><%= match.mvp %></p>
            </div>
            <div class="text-right tabular-nums">
              <p class="font-mono text-3xl font-bold text-white"><%= match.homeScore %> – <%= match.awayScore %></p>
              <p class="text-xs font-semibold mt-0.5 <%= won ? 'text-emerald-400' : 'text-rose-400' %>">
                <%= won ? 'WIN' : 'LOSS' %> · Margin <%= margin %>
              </p>
            </div>
          </div>
        </div>
      </article>
    <% }) %>
  </div>

  <p id="results-empty-state" class="hidden mt-8 text-center text-sm text-slate-400 py-12 surface-card rounded-xl">
    No match results match your current filter.
  </p>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/modal-and-toast') %>
