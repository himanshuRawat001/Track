<%- include('../partials/head') %>
<%- include('../partials/workspace-shell-start') %>

<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <p class="text-xs font-medium text-blue-400">Athletics Department Operations</p>
      <h1 class="font-display text-4xl font-bold text-white mt-1">Admin Dashboard</h1>
      <p class="text-sm text-slate-300 mt-1">Manage student-athlete rosters, varsity sports programs, scheduled fixtures, and official match scoring.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <a href="/admin/students" class="rounded-lg border border-slate-400/20 px-4 py-2 text-xs font-medium text-slate-200 hover:bg-slate-800/60 transition-colors whitespace-nowrap">Manage Students</a>
      <a href="/admin/sports-matches" class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-500 transition-colors whitespace-nowrap">Sports &amp; Matches</a>
    </div>
  </div>

  <!-- 4-Column Department KPIs -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="surface-card rounded-xl p-5">
      <p class="text-xs text-slate-400">Total Student-Athletes</p>
      <p class="font-display text-3xl font-bold text-white mt-2 tabular-nums"><%= stats.totalStudentsCount %></p>
      <p class="text-xs text-slate-400 mt-1">Registered on active rosters</p>
    </div>
    <div class="surface-card rounded-xl p-5">
      <p class="text-xs text-slate-400">Active Varsity Sports</p>
      <p class="font-display text-3xl font-bold text-blue-400 mt-2 tabular-nums"><%= stats.activeSportsCount %> / <%= stats.totalSportsCount %></p>
      <p class="text-xs text-slate-400 mt-1">Conference programs</p>
    </div>
    <div class="surface-card rounded-xl p-5">
      <p class="text-xs text-slate-400">Pending Fixtures</p>
      <p class="font-display text-3xl font-bold text-white mt-2 tabular-nums"><%= stats.upcomingFixturesCount %></p>
      <p class="text-xs text-slate-400 mt-1">Awaiting final scores</p>
    </div>
    <div class="surface-card rounded-xl p-5">
      <p class="text-xs text-slate-400">Completed Matches</p>
      <p class="font-display text-3xl font-bold text-emerald-400 mt-2 tabular-nums"><%= stats.completedResultsCount %></p>
      <p class="text-xs text-slate-400 mt-1"><%= stats.avgWinPct %>% overall win rate</p>
    </div>
  </section>

  <!-- Roster Utilization & Upcoming Fixtures -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <section class="lg:col-span-6 surface-card rounded-xl p-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="font-display text-2xl font-bold text-white">Program Roster Utilization</h2>
        <a href="/admin/sports-matches" class="text-xs font-medium text-blue-400 hover:text-blue-300">Manage programs →</a>
      </div>
      <div class="space-y-4">
        <% sports.forEach((sp) => { const pct = Math.min(100, Math.round((sp.rosterCount / sp.maxRoster) * 100)); %>
          <div>
            <div class="flex items-center justify-between text-xs mb-1.5">
              <span class="font-medium text-white"><%= sp.name %> <span class="text-slate-400 font-normal">· <%= sp.coach %></span></span>
              <span class="font-mono text-slate-300 tabular-nums"><%= sp.rosterCount %> / <%= sp.maxRoster %> (<%= pct %>%)</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full rounded-full bg-blue-500" style="width: <%= pct %>%"></div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="lg:col-span-6 surface-card rounded-xl">
      <div class="px-6 py-4 border-b border-slate-400/15 flex items-center justify-between">
        <h2 class="font-display text-2xl font-bold text-white">Fixtures Awaiting Scoring</h2>
        <a href="/admin/sports-matches" class="text-xs font-medium text-blue-400 hover:text-blue-300">Open queue →</a>
      </div>
      <div class="divide-y divide-slate-400/15">
        <% fixtures.slice(0, 5).forEach((fix) => { %>
          <div class="p-4 px-6 flex items-center justify-between gap-4">
            <div class="min-w-0">
              <p class="text-xs text-slate-400"><%= fix.sportName %> · <span class="tabular-nums"><%= fix.date %></span></p>
              <p class="text-sm font-semibold text-white truncate mt-0.5"><%= fix.title %></p>
            </div>
            <a href="/admin/sports-matches" class="rounded-lg border border-slate-400/20 px-3 py-1.5 text-xs font-medium text-blue-400 hover:bg-blue-600 hover:text-white hover:border-blue-500 transition-colors whitespace-nowrap shrink-0">
              Score Match
            </a>
          </div>
        <% }) %>
      </div>
    </section>
  </div>

  <!-- Top Athletes Overview Table -->
  <section class="surface-card rounded-xl overflow-x-auto">
    <div class="px-6 py-4 border-b border-slate-400/15 flex items-center justify-between">
      <h2 class="font-display text-2xl font-bold text-white">Top Ranked Athletes</h2>
      <a href="/admin/students" class="text-xs font-medium text-blue-400 hover:text-blue-300">Edit student records →</a>
    </div>
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-400/15 text-xs text-slate-400">
        <tr>
          <th class="py-3 px-6 font-medium">Rank</th>
          <th class="py-3 px-6 font-medium">Athlete</th>
          <th class="py-3 px-6 font-medium">Department</th>
          <th class="py-3 px-6 font-medium">Primary Sport</th>
          <th class="py-3 px-6 font-medium text-right">Points</th>
          <th class="py-3 px-6 font-medium text-right">Rating</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-400/10">
        <% topAthletes.forEach((athlete) => { %>
          <tr class="hover:bg-slate-800/35 transition-colors">
            <td class="py-3 px-6 font-mono text-xs text-blue-400 tabular-nums">#<%= athlete.rank %></td>
            <td class="py-3 px-6 font-semibold text-white"><%= athlete.name %></td>
            <td class="py-3 px-6 text-slate-300"><%= athlete.department %></td>
            <td class="py-3 px-6 text-slate-300"><%= athlete.primarySportName %></td>
            <td class="py-3 px-6 text-right font-mono tabular-nums text-white"><%= athlete.points %></td>
            <td class="py-3 px-6 text-right font-mono tabular-nums text-blue-400 font-semibold"><%= athlete.rating.toFixed(1) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</div>

<%- include('../partials/workspace-shell-end') %>
<%- include('../partials/modal-and-toast') %>
