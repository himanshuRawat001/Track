<%- include('../partials/head') %>
<%- include('../partials/workspace-shell-start') %>

<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <p class="text-xs font-medium text-blue-400">Athlete Dossier · <%= activeStudent.studentCode %></p>
      <h1 class="font-display text-4xl font-bold text-white mt-1"><%= activeStudent.name %></h1>
      <p class="text-sm text-slate-300 mt-1"><%= activeStudent.department %> · <%= activeStudent.year %> · Jersey #<%= activeStudent.jersey %></p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/leaderboard" class="rounded-lg border border-slate-400/20 px-4 py-2 text-xs font-medium text-slate-200 hover:bg-slate-800/60 transition-colors">Rank #<%= studentRank %> on Leaderboard</a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Profile Summary & Bio -->
    <section class="lg:col-span-5 space-y-6">
      <div class="surface-card rounded-xl p-6 space-y-5">
        <div class="flex items-center justify-between pb-4 border-b border-slate-400/15">
          <div>
            <p class="text-xs text-slate-400">Primary Varsity Program</p>
            <p class="font-display text-2xl font-bold text-white mt-0.5"><%= activeStudent.primarySportName %></p>
          </div>
          <div class="text-right tabular-nums">
            <p class="text-xs text-slate-400">Performance Rating</p>
            <p class="font-mono text-2xl font-bold text-blue-400 mt-0.5"><%= activeStudent.rating.toFixed(1) %></p>
          </div>
        </div>

        <p class="text-sm text-slate-300 leading-relaxed"><%= activeStudent.bio %></p>

        <dl class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-400/15 text-xs">
          <div>
            <dt class="text-slate-400">Position / Event</dt>
            <dd class="text-white font-medium mt-0.5"><%= activeStudent.position %></dd>
          </div>
          <div>
            <dt class="text-slate-400">Personal Best</dt>
            <dd class="text-white font-mono font-medium mt-0.5"><%= activeStudent.personalBest %></dd>
          </div>
          <div>
            <dt class="text-slate-400">Matches / Wins</dt>
            <dd class="text-white font-mono font-medium mt-0.5 tabular-nums"><%= activeStudent.matchesPlayed %> / <%= activeStudent.wins %> (<%= activeStudent.winRate %>%)</dd>
          </div>
          <div>
            <dt class="text-slate-400">Season Points</dt>
            <dd class="text-white font-mono font-medium mt-0.5 tabular-nums"><%= activeStudent.points %> pts</dd>
          </div>
        </dl>

        <div class="pt-4 border-t border-slate-400/15">
          <p class="text-xs text-slate-400 mb-2">Enrolled Programs</p>
          <div class="flex flex-wrap gap-2 text-xs">
            <% if (enrolledSportDetails.length === 0) { %>
              <span class="text-slate-400">No active enrollments.</span>
            <% } %>
            <% enrolledSportDetails.forEach((sp, i) => { %>
              <span class="text-slate-200 font-medium"><%= sp.name %><%= i < enrolledSportDetails.length - 1 ? ' · ' : '' %></span>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="surface-card rounded-xl p-6">
        <h2 class="font-display text-2xl font-bold text-white mb-4">Verified Split History</h2>
        <% if (activeStudent.logs.length === 0) { %>
          <p class="text-sm text-slate-400">No training splits logged yet. Add splits from your <a href="/student?studentId=<%= activeStudent.id %>" class="text-blue-400 hover:underline">Student Dashboard</a>.</p>
        <% } else { %>
          <ul class="divide-y divide-slate-400/15 text-sm">
            <% activeStudent.logs.forEach((log) => { %>
              <li class="py-3 flex items-center justify-between gap-4">
                <div>
                  <p class="font-medium text-white"><%= log.metric %></p>
                  <p class="text-xs text-slate-400"><%= log.date %> <%= log.note ? '· ' + log.note : '' %></p>
                </div>
                <span class="font-mono font-semibold text-blue-400 tabular-nums"><%= log.value %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>

    <!-- Edit Profile Form -->
    <section class="lg:col-span-7">
      <div class="surface-card rounded-xl p-6 lg:p-8">
        <h2 class="font-display text-2xl font-bold text-white">Update Athlete Profile</h2>
        <p class="text-xs text-slate-400 mt-1">Changes sync immediately across your Student Dashboard, Rosters, and Leaderboard.</p>

        <form id="student-profile-form" data-student-id="<%= activeStudent.id %>" class="mt-6 space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="prof-name" class="block text-xs font-medium text-slate-300 mb-1.5">Full Name</label>
              <input id="prof-name" name="name" type="text" required value="<%= activeStudent.name %>" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500" />
            </div>
            <div>
              <label for="prof-email" class="block text-xs font-medium text-slate-300 mb-1.5">College Email</label>
              <input id="prof-email" name="email" type="email" required value="<%= activeStudent.email %>" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="prof-dept" class="block text-xs font-medium text-slate-300 mb-1.5">Department</label>
              <input id="prof-dept" name="department" type="text" required value="<%= activeStudent.department %>" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500" />
            </div>
            <div>
              <label for="prof-year" class="block text-xs font-medium text-slate-300 mb-1.5">Academic Year</label>
              <select id="prof-year" name="year" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500">
                <% ['Freshman', 'Sophomore', 'Junior', 'Senior', 'Graduate'].forEach((yr) => { %>
                  <option value="<%= yr %>" <%= activeStudent.year === yr ? 'selected' : '' %>><%= yr %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label for="prof-jersey" class="block text-xs font-medium text-slate-300 mb-1.5">Jersey #</label>
              <input id="prof-jersey" name="jersey" type="number" min="0" max="99" value="<%= activeStudent.jersey %>" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white font-mono focus:border-blue-500" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="prof-sport" class="block text-xs font-medium text-slate-300 mb-1.5">Primary Varsity Sport</label>
              <select id="prof-sport" name="primarySportId" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500">
                <% allSports.forEach((sp) => { %>
                  <option value="<%= sp.id %>" <%= activeStudent.primarySportId === sp.id ? 'selected' : '' %>><%= sp.name %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label for="prof-position" class="block text-xs font-medium text-slate-300 mb-1.5">Position / Specialty Event</label>
              <input id="prof-position" name="position" type="text" value="<%= activeStudent.position %>" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500" />
            </div>
          </div>

          <div>
            <label for="prof-pb" class="block text-xs font-medium text-slate-300 mb-1.5">Personal Best Benchmark</label>
            <input id="prof-pb" name="personalBest" type="text" value="<%= activeStudent.personalBest %>" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500" />
          </div>

          <div>
            <label for="prof-bio" class="block text-xs font-medium text-slate-300 mb-1.5">Athlete Bio &amp; Season Focus</label>
            <textarea id="prof-bio" name="bio" rows="3" class="w-full rounded-lg border border-slate-400/20 bg-[#060B16] px-3.5 py-2.5 text-sm text-white focus:border-blue-500"><%= activeStudent.bio %></textarea>
          </div>

          <div class="pt-2 flex items-center justify-end gap-3">
            <a href="/student?studentId=<%= activeStudent.id %>" class="rounded-lg border border-slate-400/20 px-4 py-2.5 text-xs font-medium text-slate-300 hover:text-white transition-colors">Back to Dashboard</a>
            <button type="submit" class="rounded-lg bg-blue-600 px-5 py-2.5 text-xs font-semibold text-white hover:bg-blue-500 transition-colors min-h-[40px]">
              Save Athlete Profile
            </button>
          </div>
        </form>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/workspace-shell-end') %>
<%- include('../partials/modal-and-toast') %>
